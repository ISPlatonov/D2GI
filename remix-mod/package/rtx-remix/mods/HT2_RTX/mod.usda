        }

        # Windshield rain layer. The game builds it from a back-buffer readback,
        # which is black under Remix, so replace it with wet thin glass:
        # fully transmissive, refracting through an animated raindrop normal map.
        over "mat_1AB38C53610F8621"
        {
            over "Shader"
            {
                uniform asset info:mdl:sourceAsset = @AperturePBR_Translucent.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "AperturePBR_Translucent"
                bool inputs:thin_walled = 1
                float inputs:thin_wall_thickness = 0.001
                float inputs:ior_constant = 1.33
                color3f inputs:transmittance_color = (1, 1, 1)
                float inputs:transmittance_measurement_distance = 1
                asset inputs:normalmap_texture = @./textures/rain_glass_normal.dds@ (
                    colorSpace = "raw"
                )
                int inputs:encoding = 2
                int inputs:sprite_sheet_cols = 4
                int inputs:sprite_sheet_rows = 2
                int inputs:sprite_sheet_fps = 6
            }
        }
