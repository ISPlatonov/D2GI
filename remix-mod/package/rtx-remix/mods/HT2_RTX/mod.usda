#usda 1.0
(
    doc = "Hard Truck 2 RTX mod (hand-written). Material overrides keyed by game texture hash."
    upAxis = "Z"
)

over "RootNode"
{
    over "Looks"
    {
        # Surface materials (29.10). Hashes from the DebugDraws log (texture name -> Remix hash). Without a
        # diffuse_texture Remix keeps the game texture and only adds these properties; alpha test is kept
        # (use_legacy_alpha_state defaults to true).
        # Grass ground (grass0/1/2.txr): matte, fine blade normal detail
        over "mat_D9A76F3B619FF6F6"
        {
            over "Shader"
            {
                uniform asset info:mdl:sourceAsset = @AperturePBR_Opacity.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "AperturePBR_Opacity"
                float inputs:reflection_roughness_constant = 0.95
                float inputs:metallic_constant = 0.0
                asset inputs:normalmap_texture = @./textures/grass_normal.dds@ (
                    colorSpace = "raw"
                )
                int inputs:encoding = 2
            }
        }
        over "mat_AC49F549C526F2E0"
        {
            over "Shader"
            {
                uniform asset info:mdl:sourceAsset = @AperturePBR_Opacity.mdl@
